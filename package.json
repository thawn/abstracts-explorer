{
    "name": "abstracts-explorer-webui-tests",
    "version": "1.0.0",
    "type": "module",
    "description": "Unit tests for Abstracts Explorer Web UI",
    "scripts": {
        "test": "NODE_OPTIONS=--experimental-vm-modules jest",
        "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
        "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
        "typecheck": "tsc --noEmit",
        "build:js": "node scripts/build.mjs",
        "watch:js": "node scripts/build.mjs --watch",
        "build": "npm run build:js && npm run build:tailwind",
        "build:tailwind": "npx tailwindcss -i src/abstracts_explorer/web_ui/static/tailwind.input.css -o src/abstracts_explorer/web_ui/static/vendor/tailwind.css --minify",
        "watch:tailwind": "npx tailwindcss -i src/abstracts_explorer/web_ui/static/tailwind.input.css -o src/abstracts_explorer/web_ui/static/vendor/tailwind.css --watch",
        "postinstall": "npm run install:vendor && npm run setup:hooks",
        "setup:hooks": "cp .githooks/pre-commit .git/hooks/pre-commit && cp .githooks/post-checkout .git/hooks/post-checkout && cp .githooks/post-merge .git/hooks/post-merge && chmod +x .git/hooks/pre-commit .git/hooks/post-checkout .git/hooks/post-merge",
        "install:vendor": "npm run install:vendor:fontawesome && npm run install:vendor:katex && npm run build:tailwind",
        "install:vendor:fontawesome": "mkdir -p src/abstracts_explorer/web_ui/static/vendor && cp node_modules/@fortawesome/fontawesome-free/css/all.min.css src/abstracts_explorer/web_ui/static/vendor/fontawesome.min.css && cp -r node_modules/@fortawesome/fontawesome-free/webfonts src/abstracts_explorer/web_ui/static/",
        "install:vendor:katex": "mkdir -p src/abstracts_explorer/web_ui/static/vendor && cp node_modules/katex/dist/katex.min.css src/abstracts_explorer/web_ui/static/vendor/katex.min.css && cp -r node_modules/katex/dist/fonts src/abstracts_explorer/web_ui/static/vendor/"
    },
    "jest": {
        "testEnvironment": "jsdom",
        "coverageDirectory": "./coverage",
        "collectCoverageFrom": [
            "src/abstracts_explorer/web_ui/static/**/*.{ts,js}",
            "!src/abstracts_explorer/web_ui/static/**/*.test.{ts,js}",
            "!src/abstracts_explorer/web_ui/static/dist/**"
        ],
        "setupFilesAfterEnv": [
            "<rootDir>/src/abstracts_explorer/web_ui/tests/setup.js"
        ],
        "testMatch": [
            "**/src/abstracts_explorer/web_ui/tests/**/*.test.js"
        ],
        "extensionsToTreatAsEsm": [
            ".ts"
        ],
        "moduleNameMapper": {
            "^plotly\\.js-dist-min$": "<rootDir>/src/abstracts_explorer/web_ui/tests/__mocks__/plotly.js",
            "^(\\.{1,2}/.*)\\.js$": "$1"
        },
        "transform": {
            "^.+\\.(t|j)sx?$": [
                "@swc/jest",
                {
                    "jsc": {
                        "parser": {
                            "syntax": "typescript",
                            "jsx": false
                        },
                        "target": "es2022"
                    },
                    "module": {
                        "type": "es6"
                    }
                }
            ]
        }
    },
    "devDependencies": {
        "@swc/core": "^1.10.7",
        "@swc/jest": "^0.2.37",
        "@tailwindcss/cli": "^4.1.17",
        "@testing-library/dom": "^9.3.4",
        "@testing-library/jest-dom": "^6.1.5",
        "esbuild": "^0.24.2",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "tailwindcss": "^4.1.17",
        "typescript": "^5.7.3"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.1.0",
        "dompurify": "^3.2.6",
        "katex": "^0.16.25",
        "marked": "^17.0.1",
        "marked-katex-extension": "^5.1.6",
        "plotly.js-basic-dist-min": "^3.3.1"
    }
}
